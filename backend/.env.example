# ---------------------------------------------------------------
# BACKEND ENV — copy to backend/.env and fill real values.
# NEVER commit backend/.env. The service-role key is SECRET: it is
# only ever read on the server from this file (never in frontend).
# ---------------------------------------------------------------

# Your Supabase project URL (Dashboard → Settings → API)
SUPABASE_URL=

# Supabase SERVICE-ROLE key (Dashboard → Settings → API → service_role)
# WARNING: full database access. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin account used by `npm run create:admin`
# The password is NEVER hardcoded in code, and NEVER placed in the frontend.
ADMIN_EMAIL=
ADMIN_PASSWORD= # your admin login password — never commit the real one

# Port for the Express server (frontend dev server proxies /api here)
PORT=5000
