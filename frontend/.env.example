# ---------------------------------------------------------------
# FRONTEND ENV — copy to frontend/.env and fill real values.
# Only the PUBLIC anon key goes here. NEVER put the service-role
# key or any admin credential in frontend code / .env.
# ---------------------------------------------------------------

# Your Supabase project URL (Dashboard → Settings → API)
VITE_SUPABASE_URL=

# Public anon key — safe for browsers (protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Optional: API base for production builds (defaults to same-origin /api)
# VITE_API_BASE=https://your-api.onrender.com
